        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estatísticas A: 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              " const dados = pm.response.json();",
              " pm.test(\"Conta ao menos a atividade de A\", () => pm.expect(dados.totais.total).to.be.at.least(1));",
              " pm.test(\"Conta EM_ANDAMENTO\", () => pm.expect(dados.totais.emAndamento).to.be.at.least(1));",
              " pm.test(\"Conta prioridade ALTA\", () => pm.expect(dados.porPrioridade.ALTA).to.be.at.least(1));",
              " pm.test(\"Conta matéria\", () => pm.expect(dados.porMateria.some(m=>String(m.materiaId)===pm.collectionVariables.get(\"materiaId\"))).to.eql(true));",
              "}"
            ]
          }
        }
      ]
