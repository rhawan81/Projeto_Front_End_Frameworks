{
  "info": {
    "name": "API Atividades e Estatísticas — AV2",
    "_postman_id": "5a8087c0-56b7-4889-b7df-caa1fbc07182",
    "description": "Execute em ordem com backend Spring Boot ativo. Configure emailA, senhaA, emailB, senhaB (credenciais de TESTE distintas) nas variáveis da coleção. Tokens e IDs são preenchidos automaticamente. Não publique a coleção depois de executar com tokens reais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Cadastrar usuário A (201 ou 409 se já existe)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nome\":\"Estudante A\",\"email\":\"{{emailA}}\",\"senha\":\"{{senhaA}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cadastro: 201 ou e-mail já cadastrado: 409\", () => pm.expect([201,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login A: guardar token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{emailA}}\",\"senha\":\"{{senhaA}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login A: 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              " const dados = pm.response.json();",
              " pm.test(\"JWT presente\", () => pm.expect(dados.token).to.be.a(\"string\").and.not.empty);",
              " pm.collectionVariables.set(\"tokenA\", dados.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Criar matéria e guardar materiaId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/materias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "materias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nome\":\"{{materiaNome}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"materiaNome\", \"Matéria teste API \" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Matéria criada: 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              " const dados = pm.response.json();",
              " pm.collectionVariables.set(\"materiaId\", String(dados.id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Criar atividade e guardar atividadeId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/atividades",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "atividades"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"titulo\":\"Atividade do usuário A\",\"materiaId\":{{materiaId}},\"descricao\":\"Criada pelo Postman\",\"prazo\":\"{{prazo}}\",\"prioridade\":\"ALTA\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"prazo\", new Date(Date.now() + 7*24*60*60*1000).toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Atividade criada: 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              " const dados = pm.response.json();",
              " pm.test(\"Status padrão PENDENTE\", () => pm.expect(dados.status).to.eql(\"PENDENTE\"));",
              " pm.test(\"Matéria por ID\", () => pm.expect(String(dados.materiaId)).to.eql(pm.collectionVariables.get(\"materiaId\")));",
              " pm.collectionVariables.set(\"atividadeId\", String(dados.id));",
              "}"
            ]
          }
        }
      ]
    },
